# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_MOCKING=enabled

# Feature flags (true/false)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_TICKET_SALES_OPEN=false
NEXT_PUBLIC_SPEAKERS_PUBLISHED=false
NEXT_PUBLIC_PROGRAM_PUBLISHED=false
NEXT_PUBLIC_PARTNERS_PUBLISHED=false
NEXT_PUBLIC_MEDIA_PARTNERS_PUBLISHED=false
NEXT_PUBLIC_ADDRESS_CONFIRMED=false
NEXT_PUBLIC_BOOKING_ENABLED=false
NEXT_PUBLIC_CONNECT_CHAT_ENABLED=false

# External links (leave empty to use mailto fallbacks)
NEXT_PUBLIC_TICKETS_URL=
NEXT_PUBLIC_PARTNER_MAIL=hello@pmfk.example
NEXT_PUBLIC_PRESS_MAIL=press@pmfk.example
NEXT_PUBLIC_SPEAKER_MAIL=speakers@pmfk.example
NEXT_PUBLIC_ORG_MAIL=hello@pmfk.example

# Observability — optional; app runs without them
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Cookies / legal document versions sent with consents
NEXT_PUBLIC_PDN_POLICY_VERSION=2026-11-09
